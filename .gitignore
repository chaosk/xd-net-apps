# SOPS encrypted files (keep encrypted versions, ignore unencrypted)
*.dec.yaml
*.dec.yml

# Temporary files
*.tmp
.DS_Store

# Kustomize Helm inflation (kubectl kustomize --enable-helm): fetched charts materialize here.
# Use `git add -f path/to/charts/...` only if you intentionally vendor a chart under this name.
**/charts/
.helm-cache/
.kube/
